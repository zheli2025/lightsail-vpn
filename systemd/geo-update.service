[Unit]
Description=Update Clash GEOIP/GeoSite databases (China direct bypass)
Documentation=file:/usr/local/bin/geo-update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/geo-update update
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/html/geo /var/lib/geo-update /var/log/geo-update.log /run/geo-update
RuntimeDirectory=geo-update
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
